{
  "manifest_version": 3,
  "name": "Handshake AI Task Auto-Claimer",
  "version": "1.0.0",
  "description": "Automated high-speed task claiming extension for Handshake AI with real-time DOM monitoring and audio alerts.",
  "permissions": [
    "storage",
    "notifications",
    "activeTab",
    "offscreen",
    "tabs"
  ],
  "host_permissions": [
    "*://*.handshake.com/*",
    "*://*.handshake.ai/*",
    "*://*.joinhandshake.com/*",
    "*://*.handshake.app/*",
    "file:///*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Handshake AI Auto-Claimer"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.handshake.com/*",
        "*://*.handshake.ai/*",
        "*://*.joinhandshake.com/*",
        "*://*.handshake.app/*",
        "file:///*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
